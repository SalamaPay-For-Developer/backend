DEBUG=False
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=7

# Selcom (pata toka Selcom Developer Portal)
SELCOM_BASE_URL=https://sandbox.selcom.co.tz/v1
SELCOM_API_KEY=your_api_key
SELCOM_API_SECRET=your_api_secret
SELCOM_VENDOR_ID=your_vendor_id
SELCOM_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/selcom/
