[Unit]
Description=Celery Worker for SalamaPay
After=network.target redis-server.service

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/salamapay
ExecStart=/var/www/salamapay/venv/bin/celery -A backend worker -l info
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
